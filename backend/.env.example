# ═══════════════════════════════════════════════════════════════════
# SATQUERY AI — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
FLASK_ENV=development
DEBUG=true
PORT=5000

# ── Security (REQUIRED — change before deploying) ─────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string-minimum-32-chars
JWT_SECRET_KEY=replace-with-another-long-random-string

# ── Database ──────────────────────────────────────────────────────
# Development (SQLite — no setup needed):
# DATABASE_URL=sqlite:///database/satquery.db

# Production (PostgreSQL — recommended):
# DATABASE_URL=postgresql://satquery:password@localhost:5432/satquery_db

# ── Redis (optional — enables async jobs + SSE progress stream) ───
# REDIS_URL=redis://localhost:6379/0

# ── File storage ──────────────────────────────────────────────────
# UPLOAD_FOLDER=uploads
# REPORTS_FOLDER=uploads/reports
MAX_UPLOAD_MB=100

# ── CORS (comma-separated, no wildcards in production) ────────────
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Rate limiting ─────────────────────────────────────────────────
# RATELIMIT_DEFAULT=200 per minute
# LOGIN_RATE_LIMIT=10 per minute

# ── Geocoding ─────────────────────────────────────────────────────
GEOCODING_PROVIDER=nominatim
# For Google Maps (faster):
# GEOCODING_PROVIDER=google
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Satellite imagery provider ────────────────────────────────────
# Options: none | sentinel_hub | usgs_ee
SATELLITE_PROVIDER=none

# Sentinel Hub — https://www.sentinel-hub.com/
# SATELLITE_PROVIDER=sentinel_hub
# SENTINEL_HUB_CLIENT_ID=your-client-id
# SENTINEL_HUB_CLIENT_SECRET=your-client-secret

# USGS Earth Explorer — https://earthexplorer.usgs.gov/
# SATELLITE_PROVIDER=usgs_ee
# USGS_EE_USERNAME=your-username
# USGS_EE_PASSWORD=your-password

# ── ML models ─────────────────────────────────────────────────────
MODEL_DEVICE=cpu
MODEL_CACHE_DIR=.model_cache

# BLIP image captioning (Salesforce/blip-image-captioning-base)
BLIP_ENABLED=false

# BLIP VQA (Salesforce/blip-vqa-base)
BLIP_VQA_ENABLED=false

# Grounding DINO (object detection — requires weights download)
GROUNDING_DINO_ENABLED=false
# GROUNDING_DINO_WEIGHTS_PATH=/path/to/groundingdino_swint_ogc.pth
# GROUNDING_DINO_CONFIG_PATH=   # auto-detected if left empty

# BigEarthNet classifier (requires trained weights)
BIGEARTHNET_ENABLED=false
# BIGEARTHNET_MODEL_PATH=/path/to/bigearthnet_model.onnx
# BIGEARTHNET_NUM_CLASSES=19
# BIGEARTHNET_DATASET_PATH=   # path to downloaded BigEarthNet dataset

# Change detection (image-differencing fallback always available)
CHANGE_DETECTION_ENABLED=true
# CHANGE_DETECTION_MODEL_PATH=   # optional trained model weights
# CHANGE_DIFF_THRESHOLD=0.12

# SAR / Optical+SAR analysis (requires trained fusion model)
SAR_ANALYSIS_ENABLED=false
# SAR_MODEL_PATH=/path/to/sar_model.pt

# Legacy land-cover model path (kept for backward compatibility)
# LANDCOVER_MODEL_PATH=

# ── SMS / OTP (for password reset) ────────────────────────────────
# Options: development | twilio | fast2sms | msg91 | textlocal
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SECRET=
SMS_SENDER_ID=SATQRY
OTP_EXPIRY_MINUTES=10

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# MSG91 (if SMS_PROVIDER=msg91)
# MSG91_TEMPLATE_ID=

# ── Async jobs ────────────────────────────────────────────────────
ANALYSIS_JOB_TIMEOUT=600
RQ_QUEUES=analysis,default

# ── Demo mode (NEVER enable in production) ────────────────────────
DEMO_MODE=false

# ── Security headers ──────────────────────────────────────────────
SEND_SECURITY_HEADERS=true
