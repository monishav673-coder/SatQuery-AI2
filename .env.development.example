# SATQUERY AI — Development environment
# Copy to .env for local development (no Redis/PostgreSQL required)

FLASK_ENV=development
DEBUG=true
PORT=5000

SECRET_KEY=dev-secret-key-change-before-any-deployment
JWT_SECRET_KEY=dev-jwt-key-change-before-any-deployment

# SQLite — no setup needed
DATABASE_URL=sqlite:///database/satquery.db

# Redis optional in dev (enables async + SSE; falls back to sync without it)
# REDIS_URL=redis://localhost:6379/0

UPLOAD_FOLDER=uploads
REPORTS_FOLDER=uploads/reports
MAX_UPLOAD_MB=100

CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
GEOCODING_PROVIDER=nominatim
SATELLITE_PROVIDER=none

# Enable change detection fallback (image differencing, no model needed)
CHANGE_DETECTION_ENABLED=true

# ML models off by default in dev (install deps to enable)
BLIP_ENABLED=false
BLIP_VQA_ENABLED=false
GROUNDING_DINO_ENABLED=false
BIGEARTHNET_ENABLED=false
SAR_ANALYSIS_ENABLED=false

MODEL_DEVICE=cpu
MODEL_CACHE_DIR=.model_cache

# Development OTP (prints OTP to server logs — NEVER use in production)
SMS_PROVIDER=development

SEND_SECURITY_HEADERS=false
DEMO_MODE=false
