# SATQUERY AI — Production environment template
# Copy to .env.production and fill in ALL values before deploying.
# NEVER commit this file with real secrets.

FLASK_ENV=production
DEBUG=false
PORT=5000

# ── REQUIRED ──────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_64_CHAR_STRING
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_64_CHAR_STRING

DATABASE_URL=postgresql://satquery:REPLACE_WITH_DB_PASSWORD@postgres:5432/satquery_db
REDIS_URL=redis://redis:6379/0

# For docker-compose.prod.yml postgres service
POSTGRES_DB=satquery_db
POSTGRES_USER=satquery
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ── CORS (your actual domain only — no wildcards) ─────────────────
CORS_ORIGINS=https://yourdomain.com

# ── Storage ───────────────────────────────────────────────────────
UPLOAD_FOLDER=/app/backend/uploads
REPORTS_FOLDER=/app/backend/uploads/reports
MAX_UPLOAD_MB=100

# ── Security ──────────────────────────────────────────────────────
SEND_SECURITY_HEADERS=true

# ── Geocoding ─────────────────────────────────────────────────────
GEOCODING_PROVIDER=nominatim
# GEOCODING_PROVIDER=google
# GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_API_KEY

# ── Satellite imagery provider ────────────────────────────────────
SATELLITE_PROVIDER=sentinel_hub
SENTINEL_HUB_CLIENT_ID=REPLACE_WITH_SENTINEL_HUB_CLIENT_ID
SENTINEL_HUB_CLIENT_SECRET=REPLACE_WITH_SENTINEL_HUB_SECRET

# ── ML models ─────────────────────────────────────────────────────
MODEL_DEVICE=cpu
MODEL_CACHE_DIR=/app/backend/.model_cache

BLIP_ENABLED=true
BLIP_VQA_ENABLED=true
GROUNDING_DINO_ENABLED=true
GROUNDING_DINO_WEIGHTS_PATH=/app/backend/models/groundingdino_swint_ogc.pth

BIGEARTHNET_ENABLED=false
# BIGEARTHNET_MODEL_PATH=/app/backend/models/bigearthnet_model.onnx

CHANGE_DETECTION_ENABLED=true
# CHANGE_DETECTION_MODEL_PATH=/app/backend/models/change_detection.pt

SAR_ANALYSIS_ENABLED=false
# SAR_MODEL_PATH=/app/backend/models/sar_model.pt

# ── SMS / OTP ─────────────────────────────────────────────────────
SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=REPLACE_WITH_TWILIO_AUTH_TOKEN
SMS_SENDER_ID=SATQRY
OTP_EXPIRY_MINUTES=10
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER

# ── Async jobs ────────────────────────────────────────────────────
ANALYSIS_JOB_TIMEOUT=600
RQ_QUEUES=analysis,default

# ── Demo mode (must be false in production) ───────────────────────
DEMO_MODE=false
